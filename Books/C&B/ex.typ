// ⚠️ 这里刻意 **不放** “过宽公式自动缩放” 的 show 规则。
// 原因（实测踩坑）：`show math.equation.where(block: true): it => layout(..)` 返回的是一个
// block 元素；当该公式出现在段落内部（例如 `#sub[(a) $...$]`、`#cont[...]` 里）时，
// Typst 会报 `warning: block may not occur inside of a paragraph and was ignored`
// 并把公式**整条丢弃**——编译仍返回 0，内容却凭空少了。
// 替代做法：用 overflow.py 体检，对个别过宽公式手工加 `\` 断行。

// ---------- 标题 ----------
#show heading.where(level: 1): it => block(
  width: 100%, above: 1.5em, below: 1.0em,
  align(center, text(size: 17pt, weight: "bold", it.body)),
)
#show heading.where(level: 2): it => block(
  width: 100%, above: 1.2em, below: 0.65em,
  text(size: 13pt, weight: "bold", it.body),
)
#show heading.where(level: 3): it => block(
  width: 100%, above: 1.0em, below: 0.5em,
  text(size: 11pt, weight: "bold", it.body),
)

// ---------- 习题条目 ----------
// 用法：#ex("3.1")[ 设随机变量 ... ]
// 悬挂缩进：编号顶格，正文对齐，换行后与正文起始位置对齐
#let ex(n, body) = block(
  above: 0.55em, below: 0.2em, width: 100%,
  grid(
    columns: (auto, 1fr), column-gutter: 0.55em,
    align: (right + top, left + top),
    text(weight: "bold", n),
    body,
  ),
)

// 小问 (a)(b)(c)：整体左缩进 3.2em，换行后与首行对齐（悬挂缩进）
// ⚠️ 必须用 block（不能直接返回 par）：实测相邻 block 之间必须有足够的 above/below，
// 否则 Typst 会把它们排成零行距、文字互相重叠。
#let sub(body) = {
  set par(leading: 1.05em, first-line-indent: 0em, justify: true)
  block(above: 0.38em, below: 0.38em, width: 100%, inset: (left: 3.2em))[#body]
}

// 无编号的续段（承接上一小题、或跨页续接的说明文字）
#let cont(body) = {
  set par(leading: 1.05em, first-line-indent: (amount: 2em, all: true), justify: true)
  block(above: 0.38em, below: 0.38em, width: 100%)[#body]
}

// ---------- 编号公式（右对齐编号） ----------
#let eqn(n, body) = block(above: 0.7em, below: 0.7em, width: 100%)[
  #grid(
    columns: (1fr, auto), align: (center + horizon, right + horizon),
    gutter: 0.5em, body, text(size: 9.5pt)[#n],
  )
]

// ---------- 插图 ----------
// 用法：#bookfig("figs/p0123-f1.png", "图 3.7.1 示意")[说明]
#let bookfig(src, caption: none, width: 70%) = {
  set par(first-line-indent: 0em)
  block(above: 0.7em, below: 0.7em, width: 100%)[
    #align(center)[#image(src, width: width)]
    #if caption != none {
      v(0.3em)
      align(center)[#text(size: 9pt)[#caption]]
    }
  ]
}

// ---------- 定理类环境（习题中引用/复述时备用） ----------
#let named-env(name, pre, ..args) = {
  let pos = args.pos()
  let body = if pos.len() >= 1 { pos.at(0) } else { [] }
  block(above: 0.6em, below: 0.6em, width: 100%)[
    #set par(first-line-indent: (amount: 2em, all: true))
    #text(weight: "bold")[#name]
    #h(0.5em)#body
  ]
}

#let theorem(..a) = named-env("定理", (), ..a)
#let definition(..a) = named-env("定义", (), ..a)
#let example(..a) = named-env("例", (), ..a)
#let lemma(..a) = named-env("引理", (), ..a)
#let corollary(..a) = named-env("推论", (), ..a)
#let note(..a) = named-env("注", (), ..a)



