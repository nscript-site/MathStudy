#align(center)[$ phi(bold(X)) = cases(1 &quad "若" M_n >= c, 0 &quad "其他") $]

#itemb([(1) 求检验 $phi(bold(X))$ 的势函数，并证明它是 $theta$ 的单调递增函数；])
#itemb([(2) 在检验 $H_0: theta <= 1/2$ 对 $H_1: theta > 1/2$ 中，选择什么样的 $c$ 能使检验的尺码 $alpha_0$ 恰好是 $0.05$？])
#itemb([(3) 画出当 $n = 20$ 时 (2) 中指定的 $phi(bold(X))$ 的势函数的粗略图形；])
#itemb([(4) $n$ 该多大，能使 (2) 中指定的 $phi(bold(X))$，对于 $theta = 3/4$ 有势 $0.98$？])])

#item("7-10.", [设子样 $(X_1, X_2, dots, X_n)$ 取自均匀分布母体 $R(theta - 1/2, theta + 1/2)$，$theta$ 为未知参数。对检验问题 $H_0: theta <= 3$ 对 $H_1: theta >= 4$ 构造一个检验函数，使其势函数为

#align(center)[$ beta_phi(theta) = cases(1 &quad theta >= 4, 0 &quad theta <= 3) $]])

#item("7-11.", [设一个观察值 $X$ 取自密度函数为 $f(x)$ 的母体，对 $f(x)$ 建立假设

#align(center)[$ H_0: quad f_0(x) = cases(1 &quad 0 <= x <= 1, 0 &quad "其他") quad "对" quad H_1: quad f_1(x) = cases(2x &quad 0 <= x <= 1, 0 &quad "其他") $]

试求一检验函数使犯两类错误的概率满足 $alpha + 2 beta = min$，并求此最小值。])
#section-title("§7.2　正态母体的假设检验")

