#item("9-125.", [设 $xi(t) = cos(eta t + theta)$（$-oo < t < oo$），其中 $eta$，$theta$ 为相互独立的实随机变量，$theta$ 的特征函数 $g(i)$ 满足条件：$g(1) = g(2) = 0$，$eta$ 具有对称的分布密度 $h(y)$，则 $xi(t)$ 为平稳过程且具有谱密度，求此谱密度。])

#item("9-126.", [设 $xi(t) = f(t - theta)$（$-oo < t < oo$），其中 $f(t)$ 为具有周期 $l$ 的实值连续函数，$theta$ 为在 $[0, l]$ 上均匀分布的随机变量，则 $xi(t)$ 为平稳过程，求相关函数。])

#item("9-127.", [设 $xi(t)$（$-oo < t < oo$）为平稳过程且不恒等于一个随机变量，$eta$ 为方差有限的随机变量，又])

#itemb([（1）$eta$ 与 $(xi(t), -oo < t < oo)$ 不相关，])

#itemb([（2）$eta = xi(0)$，])

#itemb([问 $eta(t) = xi(t) + eta$（$-oo < t < oo$）是否为平稳过程？])

#item("9-128.", [设 $xi(t)$，$eta(t)$（$-oo < t < oo$）为两个平稳相关的平稳过程，证明 $zeta(t) = xi(t) + eta(t)$（$-oo < t < oo$）也为平稳过程。])

#item("9-129.", [设 $xi(t)$（$-oo < t < oo$）为平稳过程，具有谱密度 $f(lambda)$，则对任意 $h > 0$，$eta(t) = xi(t + h) - xi(t)$（$-oo < t < oo$）为平稳过程（即平稳过程是具有平稳增量的），求 $eta(t)$ 的谱密度。])

#item("9-130.", [设 $xi(t)$（$-oo < t < oo$）为（实）平稳正态过程，均值为零且相关函数为 $R_xi(t)$，证明：$xi^2(t)$（$-oo < t < oo$）也是平稳过程，并求它的均值与相关函数。])

#item("9-131.", [设二阶矩过程 $eta_1(t)$（$-oo < t < oo$）有均值函数 $E eta_1(t) = alpha + beta t$，协方差函数 $B(s, t) = e^(-lambda |s - t|)$，则 $xi(t) = eta_1(t + 1) - eta_1(t)$ 为平稳过程，求它的均值函数及相关函数。])

#item("9-132.", [设平稳序列 $xi(n)$（$-oo < n < oo$）满足条件：])

#align(center)[$ E xi(n) = 0, quad E xi(n) overline(xi(m)) = cases(1 & quad n = m, 0 & quad n != m) $]

#itemb([（这样的平稳序列称为"白声"），求它的谱函数及谱密度。])

#item("9-133.", [设平稳序列 $xi(n)$（$-oo < n < oo$）的相关函数 $R(n)$ 满足条件：])

#align(center)[$ sum_(-oo)^oo |R(n)| < oo $]

#itemb([则平稳序列具有谱密度：])

#align(center)[$ f(lambda) = 1/(2 pi) sum_(-oo)^oo R(n) e^(-i n lambda) $]

#item("9-134.", [设 $xi(n)$（$-oo < n < oo$）为"白声"，则])

#align(center)[$ eta(n) = 1/m [xi(n) + xi(n - 1) + dots + xi(n - m + 1)] $]

#itemb([为平稳序列并求它的相关函数。])

#item("9-135.", [设 $xi(n)$（$-oo < n < oo$）为"白声"，$|a| < 1$，则])

#align(center)[$ eta(n) = sum_(k=0)^oo a^k xi(n - k) $]

#itemb([为平稳序列，并求它的相关函数及谱密度。])

#item("9-136.*", [平稳序列 $xi(n)$（$-oo < n < oo$）称为 $m$ -相关的，若它的相关函数 $R(n)$ 满足条件：$R(n) = 0$，$|n| > m$，$R(m) != 0$，证明：平稳序列 $xi(n)$ 为 $m$ -相关的充要条件是它可表为有限滑动和：])

#align(center)[$ xi(n) = sum_(k=0)^m a_k eta(n - k), quad a_0 a_m != 0 $]

#itemb([其中 $eta(n)$ 为"白声"。])

#item("9-137.*", [证明：平稳序列 $xi(n)$ 为 $m$ -相关的充要条件是它具有谱密度：])

#align(center)[$ f(lambda) = 1/(2 pi) |sum_(k=0)^m a_k e^(-i k lambda)|^2, quad a_0 a_m != 0 $]

#item("9-138.*", [存在平稳序列 $xi(n)$ 满足差分方程])

#align(center)[$ a_0 xi(n) + a_1 xi(n - 1) + dots + a_m xi(n - m) = eta(n) $]

#itemb([（$eta(n)$ 为"白声"）的充要条件为多项式 $sum_(k=0)^m a_k z^k$ 在 $|z| = 1$ 上没有零点，且这时 $xi(n)$ 具有谱密度：])

#align(center)[$ f(lambda) = 1/(2 pi) dot 1/|sum_(k=0)^m a_k e^(-i k lambda)|^2 $]

#itemb([（这样的平稳序列 $xi(n)$ 称为自回归模型）。])

#item("9-139.*", [平稳序列 $xi(n)$ 为自回归模型的充要条件是它的相关函数 $R(n)$ 满足条件：])

#align(center)[$ a_0 R(n) + a_1 R(n - 1) + dots + a_m R(n - m) = 0, quad n = 1, 2, dots $]

#itemb([且 $sum_(k=0)^m a_k z^k$ 在 $|z| = 1$ 上没有零点。])

#item("9-140.", [构造一个平稳过程，它不是均方连续的。])

#item("9-141.", [设 $xi$，$eta$ 是两个独立的实随机变量，$E xi = 0$，$D xi = 1$，又 $eta$ 的分布函数为 $F(lambda)$，证明：])

#align(center)[$ xi(t) = xi e^(i eta t) quad (-oo < t < oo) $]

#itemb([为平稳过程，且它的谱函数就是 $F(lambda)$。])

#item("9-142.", [已知平稳过程（连续参数）的谱密度为：])

#itemb([（1）$f(lambda) = cases(a & quad |lambda| <= b, 0 & quad |lambda| > b)$])

#itemb([（2）$f(lambda) = cases(c^2 & quad lambda_0 <= |lambda| <= 2 lambda_0, 0 & quad "其他")$（$lambda_0 > 0$）])

#itemb([（3）$f(lambda) = 1/pi sum_(j=1)^n (sigma_j^2)/(lambda^2 + lambda_j^2)$（$lambda_j$，$sigma_j$ 为正数）])

#itemb([求相关函数。])

#item("9-143.", [设连续参数平稳过程 $xi(t)$ 的相关函数 $R(t)$ 满足条件])

#align(center)[$ integral_(-oo)^oo |R(t)| dif t < oo $]

#itemb([则平稳过程具有谱密度：])

#align(center)[$ f(lambda) = 1/(2 pi) integral_(-oo)^oo R(t) e^(-i t lambda) dif t $]

#item("9-144.", [已知平稳过程（连续参数）的相关函数为：])

#itemb([（1）$R(t) = e^(-alpha |t|) (1 + alpha |t|)$（$alpha > 0$）])

#itemb([（2）$R(t) = e^(-alpha |t|) cos beta t$（$alpha > 0$），])

#itemb([求谱密度。])

#item("9-145.", [设平稳过程 $xi_a(t)$（$-oo < t < oo$）有谱密度：])

#align(center)[$ f_a(lambda) = cases(c & quad |lambda| <= a, 0 & quad |lambda| > a) quad (a > 0, c > 0) $]

#itemb([则相关函数 $R_a(t)$ 满足条件：])

#align(center)[$ lim_(a -> oo) (R_a(t))/(R_a(0)) = cases(0 & quad t != 0, 1 & quad t = 0) $]

#item("9-146.", [证明：平稳过程 $xi(t)$（$-oo < t < oo$）具有均方导数的充要条件为相关函数 $R(t)$ 在 $t = 0$ 点两次可导，或谱函数 $F(lambda)$ 满足条件：])

#align(center)[$ integral_(-oo)^oo lambda^2 dif F(lambda) < oo $]

#item("9-147.", [设平稳过程 $xi(t)$（$-oo < t < oo$）具有均方导数，则 $xi(t)$ 与 $xi'(t)$ 平稳相关，求互相关函数及互谱函数。])

#item("9-148.", [设 $xi(t)$（$-oo < t < oo$）为平稳过程，谱密度为 $f_xi(lambda)$，又 $beta > 0$ 为常数，则])

#align(center)[$ eta(t) = integral_(-oo)^t e^(-beta (t - s)) xi(s) dif s $]

#itemb([为平稳过程，求它的谱密度。])

#item("9-149.", [设 $xi(t)$（$-oo < t < oo$）为平稳过程，谱密度为 $f_xi(lambda)$，又 $beta > 0$，$omega_0 > 0$ 为常数，则])

#align(center)[$ eta(t) = integral_(-oo)^t e^(-beta (t - s)) (sin omega_0 (t - s))/(omega_0) xi(s) dif s $]

#itemb([为平稳过程，求它的谱密度。])

#item("9-150.", [设下列电路的输入为平稳过程 $xi(t)$（$-oo < t < oo$），具有谱密度 $f(lambda)$，则输出 $eta(t)$ 也为平稳过程，并求它的谱密度。])

