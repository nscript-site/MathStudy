#item("9-151.*", [设平稳序列 $xi(n)$ 具有谱密度 $f(lambda)$，令])

#align(center)[$ b_n = D[sum_(k=0)^n xi(k)] $]

#itemb([则 $lim_(N -> oo) 1/N sum_(n=1)^N b_n = integral_(-pi)^pi f(lambda)/(2 sin^2 (lambda/2)) dif lambda$。])

#item("9-152.*", [设（连续参数）平稳过程 $xi(t)$ 具有谱密度 $f(lambda)$，令])

#align(center)[$ b_t = D[integral_0^t xi(s) dif s] $]

#itemb([则 $lim_(T -> oo) 1/T integral_0^T b_t dif t = integral_(-oo)^oo (2 f(lambda))/lambda^2 dif lambda$。])

#item("9-153.*", [设 $xi(t)$（$-oo < t < oo$）为平稳过程，则离散参数时])

#align(center)[$ 1/N sum_(n=1)^N xi(n) -> E xi(n), quad N -> oo $]

#itemb([或连续参数时])

#align(center)[$ 1/T integral_0^T xi(t) dif t -> E xi(t), quad T -> oo $]

#itemb([的充要条件为谱函数 $F(lambda)$ 在 $lambda = 0$ 点连续。])

#item("9-154.*", [设平稳序列 $xi(n)$ 的相关函数 $R(n)$ 满足条件：])

#align(center)[$ sum_(-oo)^oo |n R(n)| < oo $]

#itemb([则 $lim_(N -> oo) 1/(4 pi N) E |sum_(n=-N)^N xi(n) e^(-i n lambda)|^2 = f(lambda)$。])

#item("9-155.*", [设（连续参数）平稳过程 $xi(t)$ 的相关函数满足条件：])

#align(center)[$ integral_(-oo)^oo |t R(t)| dif t < oo $]

#itemb([则 $lim_(T -> oo) 1/(4 pi T) E |integral_(-T)^T xi(t) e^(-i t lambda) dif t|^2 = f(lambda)$。])

#item("9-156.", [设（连续参数）平稳过程 $xi(t)$ 具有实相关函数 $R(t)$，对 $T > 0$ 求常数 $a$，$b$，使])

#align(center)[$ E |integral_0^T xi(t) dif t - [a xi(0) + b xi(T)]|^2 = min $]

#item("9-157.", [证明：随机序列 $xi(n)$（$-oo < n < oo$）具有平稳增量的充要条件为 $xi(n + 1) - xi(n)$（$-oo < n < oo$）为平稳序列。])

#item("9-158.", [设 $xi(t)$（$-oo < t < oo$）为平稳过程，证明：随机过程])

#align(center)[$ eta(t) = integral_0^t xi(s) dif s $]

#itemb([具有平稳增量。])

#item("9-159.*", [设平稳随机过程 $xi(t)$ 具有谱密度 $f(lambda)$，且 $|lambda| > omega$ 时，$f(lambda) = 0$。证明对一切 $t$ 成立下列两个公式：])

#itemb([（1）$xi(t) = sum_(k=-oo)^oo xi((k pi)/omega) (sin(omega t - k pi))/(omega t - k pi)$；])

#itemb([（2）$xi(t) = sum_(k=0)^oo (xi^((k))(0))/(k!) t^k$。])

#item("9-160.", [设平稳随机过程 $xi(t)$ 有谱密度 $f(lambda)$，证明对任意 $h > 0$，])

#align(center)[$ eta(n) = 1/h integral_((n - 1/2) h)^((n + 1/2) h) xi(t) dif t $]

#itemb([为平稳序列，并求它的谱密度。])

