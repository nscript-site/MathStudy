#item("9-96.", [设 $B(s, t)$ 为协方差函数，证明：（1）$"Re" {B(s, t)}$，（2）$a^2 B(s, t)$（$a$ 为任意实数），也是协方差函数。])

#item("9-97.", [设 $B_1(s, t)$，$B_2(s, t)$ 均为协方差函数，证明：（1）$B_1(s, t) + B_2(s, t)$，（2）$B_1(s, t) B_2(s, t)$ 也是协方差函数。])

#item("9-98.", [设 $B_n(s, t)$（$n = 1, 2, dots$）为一列协方差函数，设：])

#itemb([（1）$B(s, t) = sum_(n=1)^oo p_n B_n(s, t)$，其中 $p_n >= 0$，$sum_(n=1)^oo p_n = 1$；])

#itemb([（2）$B(s, t) = lim_(n -> oo) B_n(s, t)$（若 $lim_(n -> oo) B_n(s, t)$ 存在）；])

#itemb([证明：$B(s, t)$ 也为协方差函数。])

#item("9-99.", [设 $B(s, t)$ 为二阶矩过程 $xi(t)$（$t >= 0$）的协方差函数，又 $E xi(t) = 0$，$xi'(t)$ 存在，证明：$xi'(t)$ 的协方差函数为 $(partial^2)/(partial s partial t) B(s, t)$。])

#item("9-100.", [设二阶矩过程 $(xi(t), t >= 0)$ 可导，又 $f(t)$ 为可导函数，证明：])

