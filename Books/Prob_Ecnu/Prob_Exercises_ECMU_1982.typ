#itemb([（1）$sum_(n=0)^oo P(xi <= n) s^n$，　（2）$sum_(n=0)^oo P(xi >= n) s^n$，])

#itemb([（3）$sum_(n=0)^oo P(xi = 2 n) s^n$。])

