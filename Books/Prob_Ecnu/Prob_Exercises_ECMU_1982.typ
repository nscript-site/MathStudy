#item("9-101.", [设 $B(s, t)$ 为二阶矩过程 $(xi(t), t >= 0)$ 的协方差函数，且 $B(s, t)$ 关于 $(s, t)$ 连续，又 $E xi(t) = 0$，$eta(t) = integral_0^t xi(s) dif s$ 存在，证明：$eta(t)$ 的协方差函数为：])

#align(center)[$ integral_0^s integral_0^t B(u, v) dif u dif v $]

#item("9-102.", [设二阶矩过程 $xi(t)$ 在 $[a, b]$ 上可积，证明：])

#itemb([（1）$D[integral_a^b xi(t) dif t] <= (b - a) integral_a^b D[xi(t)] dif t$；])

#itemb([（2）$sqrt(D[integral_a^b xi(t) dif t]) <= integral_a^b sqrt(D[xi(t)]) dif t$。])

#item("9-103.", [设二阶矩过程 $(xi(t), t >= 0)$ 具有零均值函数及协方差函数 $B(s, t)$。若 $B(s, t)$ 为连续函数，则 $eta(t) = integral_0^t xi(s) dif s$ 存在，且 $eta'(t) = xi(t)$。])

#item("9-104.", [证明：随机微分方程])

#align(center)[$ xi'(t) = a(t) xi(t) + eta(t) $]

#align(center)[$ xi(t_0) = xi_0 $]

#itemb([具有随机解：])

#align(center)[$ xi(t) = xi_0 e^(integral_(t_0)^t a(tau) dif tau) + integral_(t_0)^t e^(integral_s^t a(tau) dif tau) eta(s) dif s $]

